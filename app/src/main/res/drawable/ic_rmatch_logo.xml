<?xml version="1.0" encoding="utf-8"?>
<!-- R-Match branded football logo: dark circle + green field lines + ball highlight -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark background circle -->
    <path
        android:fillColor="#0D1117"
        android:pathData="M54,54 m-54,0 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0" />

    <!-- Green outer ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2EE6A8"
        android:strokeWidth="2.5"
        android:pathData="M54,54 m-46,0 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0" />

    <!-- Football pitch center circle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2EE6A8"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.5"
        android:pathData="M54,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />

    <!-- Horizontal center line -->
    <path
        android:strokeColor="#2EE6A8"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:pathData="M18,54 L90,54" />

    <!-- Vertical center line -->
    <path
        android:strokeColor="#2EE6A8"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:pathData="M54,18 L54,90" />

    <!-- "R" letter -->
    <path
        android:fillColor="#E6EDF3"
        android:pathData="M 34,38 L 34,70
                          M 34,38 Q 46,38 46,46 Q 46,54 34,54
                          M 40,54 L 46,70" />

    <!-- Thin white strokes for R -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E6EDF3"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 34,38 L 34,70 M 34,38 Q 46,38 46,46 Q 46,54 34,54 M 40,54 L 47,70" />

    <!-- "M" letter -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2EE6A8"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 52,70 L 52,38 L 62,54 L 72,38 L 72,70" />

    <!-- Center dot -->
    <path
        android:fillColor="#2EE6A8"
        android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

</vector>
